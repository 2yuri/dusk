        {
          "type": "script",
          "id": "GzuQb",
          "name": "Bars",
          "width": "fill_container",
          "height": 480,
          "script": "\nconst rows = params.rows, max = params.max\nconst labelW = 170, valueW = 90, barH = 18, gapIn = 6, rowH = barH * 2 + gapIn + 22\nconst plotW = width - labelW - valueW\nctx.textBaseline = 'middle'\nrows.forEach((r, i) => {\n  const y = i * rowH\n  ctx.fillStyle = params.text; ctx.font = '600 16px Inter'\n  ctx.fillText(r.label, 0, y + barH + gapIn / 2)\n  const bars = [[r.dusk, params.dusk, params.text], [r.dr, params.dr, params.muted]]\n  bars.forEach(([v, color, ink], j) => {\n    const by = y + j * (barH + gapIn)\n    const w = Math.max(3, plotW * Math.min(v, max) / max)\n    ctx.fillStyle = color\n    ctx.beginPath(); ctx.roundRect(labelW, by, w, barH, 4); ctx.fill()\n    ctx.fillStyle = ink; ctx.font = (j === 0 ? '600 ' : '400 ') + '13px JetBrains Mono'\n    ctx.fillText(v.toFixed(0) + ' ms', labelW + w + 10, by + barH / 2)\n  })\n  if (r.note) { ctx.fillStyle = params.muted; ctx.font = '400 12px Inter'; ctx.fillText(r.note, 0, y + barH * 2 + gapIn + 10) }\n})",
          "params": {
            "rows": [
              {
                "label": "pending",
                "dusk": 1,
                "dr": 1
              }
            ],
            "max": 100,
            "dusk": "$primary",
            "dr": "#4A4560",
            "text": "$text",
            "muted": "$muted"
          }
        },
