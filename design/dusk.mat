          "type": "text",
          "id": "DKlC6",
          "name": "Footnote",
          "content": "pending",
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "400",
          "lineHeight": 1.45,
          "textStyle": "Small",
          "fill": "$muted",
          "textGrowth": "fixed-width",
          "width": "fill_container"
        }
      ]
    }
