{
  "manifest_version": 3,
  "name": "Dusk",
  "version": "1.0.0",
  "description": "Dark mode for every website. Small, fast, and light on your CPU.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "alarms",
    "favicon"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dusk",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "toggle-global": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Turn Dusk on or off everywhere"
    },
    "toggle-site": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Turn Dusk on or off for this site"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ]
}
